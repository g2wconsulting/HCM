# Copy this file to .env and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose in the browser bundle — it only grants
# what your Row Level Security policies allow.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your canonical production URL (e.g. https://hcm-beige.vercel.app).
# Used only by "Copy Link" on a timecard so it always builds a link to your
# real domain instead of whatever origin the browser happens to be on
# (falls back to window.location.origin if unset). The emails themselves
# are built server-side from the Supabase SITE_URL secret — see README.
VITE_SITE_URL=https://your-production-domain
