# Copy this file to .env and fill in your Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose in the browser bundle — it only grants
# what your Row Level Security policies allow.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
